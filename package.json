{
  "name": "andrescreation-portfolio",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "img": "node scripts/optimize-images.mjs",
    "img:strict": "node scripts/optimize-images.mjs --strict",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "content:lint": "node scripts/content-lint.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:lh": "lhci autorun",
    "test:links": "linkinator http://localhost:3000 --recurse --skip 'wa.me|linkedin.com'",
    "test:all": "npm run lint && npm run typecheck && npm run content:lint && npm run test:unit && npm run build && npm run test:e2e && npm run test:a11y && npm run test:lh"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "linkinator": "^6.1.3",
    "prettier": "^3.5.3",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
